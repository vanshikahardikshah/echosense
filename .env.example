# Copy this file to .env (same folder you start the hub from) and fill in what you have.
# Everything is optional: without it, calls and texts are logged as dry runs.

# Claude: each agent becomes Claude with tools (asks phones, the Cartographer, the home history)
ANTHROPIC_API_KEY=
# Only if the hub says the key is not scoped to a workspace: the workspace id (wrkspc_...) from console.anthropic.com
# ANTHROPIC_WORKSPACE_ID=
# ECHOSENSE_LLM=agent        (agent | reason | narrate | off)
# ECHOSENSE_LLM_MODEL=claude-haiku-4-5-20251001

# Twilio (console.twilio.com): Account SID, Auth Token, your Twilio phone number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1
# Who gets called (on a trial account this number must be verified in Twilio). Several: comma separated.
CAREGIVER_PHONE=+1
# Your cloudflared https address, so the caregiver can press 1 (on my way) or 2 (false alarm)
PUBLIC_URL=https://
# Set to 0 to skip texts (US trial texts can be blocked without 10DLC registration)
# ECHOSENSE_SMS=1

# Discord or Slack webhook for the chat message
ECHOSENSE_WEBHOOK=
# Seconds to wait for "Are you OK?" before calling
# ECHOSENSE_ASK_TIMEOUT=30

# Cisco Webex: create a bot at developer.webex.com (My Webex Apps, Create a Bot) and paste its token.
# Then either your own Webex email (the bot messages you directly) or a space id the bot was added to.
WEBEX_BOT_TOKEN=
WEBEX_TO_EMAIL=
# WEBEX_ROOM_ID=

# AGNTCY SLIM: the hub runs a SLIM node itself on port 46357. To use your own node instead:
# SLIM_ENDPOINT=http://localhost:46357
# ECHOSENSE_SLIM=0 turns SLIM off (in memory channel)
